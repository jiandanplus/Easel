<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.easel.backup-drill</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Easel-build/backup-drill/venv/bin/python</string>
    <string>__HOME__/Easel-build/backup-drill/restore_drill.py</string>
  </array>
  <!-- 每周一 10:00；电脑当时休眠则在唤醒后补跑 -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/Easel/backup-drill.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/Easel/backup-drill.log</string>
</dict>
</plist>
