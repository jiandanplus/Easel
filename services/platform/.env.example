# 模板：复制到仓库外的 /etc/easel-central/central.env，替换全部占位符并 chmod 600。
# CENTRAL_DATABASE_URL 必须使用非 owner、无高权限、无 owner 角色成员关系的 runtime role。
CENTRAL_DATABASE_URL='postgresql://central_runtime:REPLACE_RUNTIME_PASSWORD@db.example.invalid:5432/easel_central?sslmode=verify-full'
CENTRAL_PUBLIC_URL='https://accounts.example.invalid'
CENTRAL_DB_SCHEMA='central'
CENTRAL_POOL_MIN='1'
CENTRAL_POOL_MAX='5'

# 从 Logto discovery 的 issuer 字段取得；通常是认证域名加 /oidc，无结尾斜杠。
CENTRAL_OIDC_ISSUER='https://login.example.invalid/oidc'
# key 是中央 product_id；client_id/secret 是对应 Logto Traditional Web 应用的凭据。
# 不是 Easel 本地公开 client_id，也不是 Logto Management API 的 M2M 凭据。
CENTRAL_OIDC_CLIENTS='{"easel":{"client_id":"REPLACE_LOGTO_APPLICATION_ID","client_secret":"REPLACE_LOGTO_APPLICATION_SECRET"}}'

# 仅隔离 loopback HTTP 演练可改为 1，生产保留 0 并使用 HTTPS。
CENTRAL_ALLOW_LOOPBACK_HTTP='0'

# 默认不开放购买。正式 HTTPS 商户部署改 live，并使用仓库外 0600 配置文件。
# test 仅用于显式 literal loopback 开发环境，不能发放正式点数。
CENTRAL_PAYMENTS_MODE='disabled'
# CENTRAL_PAYMENTS_CONFIG_FILE='/etc/easel-central/payments.json'
# 1 为服务内持久队列 worker；0 可将调度分离到受控 payments-work 进程。
CENTRAL_PAYMENTS_WORKER='1'

# 不设置时默认关闭模型执行；配置结构和不可变模型发布见 EXECUTION.md。
# 文件由运行用户持有、0600、非符号链接；test 仅接本机模拟上游，live 必须 HTTPS。
# CENTRAL_EXECUTION_CONFIG_FILE='/etc/easel-central/execution.json'

# 不要把 migration owner 的 URL 放入常驻服务配置。
# 单独受保护的 central-operator.env 可追加以下参数；运行时服务不得加载它：
# CENTRAL_MIGRATION_DATABASE_URL='postgresql://central_owner:REPLACE_OWNER_PASSWORD@db.example.invalid:5432/easel_central?sslmode=verify-full'

# 以下属于 Easel 本地服务的环境，不是中央服务参数；在 Easel 启动配置中设置：
# EASEL_PLATFORM_URL='https://accounts.example.invalid'
# EASEL_PLATFORM_CLIENT_ID='easel-desktop'
