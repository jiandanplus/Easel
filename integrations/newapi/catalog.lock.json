  "upgradeNotes": [
    {
      "id": "release-candidate",
      "summary": "GitHub latest returns this tag and prerelease=false, but the tag and release notes identify a release candidate before the final v1 release.",
      "sourceUrl": "https://github.com/QuantumNous/new-api/releases/tag/v1.0.0-rc.45"
    },
    {
      "id": "video-pricing",
      "summary": "Users upgrading from rc.26 or earlier must reconfigure video model prices after the rc.27 task-plugin architecture change; inspect existing prices before enabling traffic.",
      "sourceUrl": "https://github.com/QuantumNous/new-api/releases/tag/v1.0.0-rc.37"
    },
    {
      "id": "playground-history",
      "summary": "rc.44 moves Playground storage to per-account records and clears previous Playground history once after upgrade.",
      "sourceUrl": "https://github.com/QuantumNous/new-api/releases/tag/v1.0.0-rc.44"
    },
    {
      "id": "sensitive-word-filter",
      "summary": "rc.45 disables sensitive-word filtering by default; deployments that entered a word list without explicitly saving the switch must re-enable it in Request checks after upgrade.",
      "sourceUrl": "https://github.com/QuantumNous/new-api/releases/tag/v1.0.0-rc.45"
    },
    {
      "id": "runtime-factory",
      "summary": "This host embeds 11 marketplace plugins at exactly the catalog versions and source hashes; Incho and TypeSafe require marketplace upload. Installation and runtime registration do not configure supplier credentials, model prices, or prove live inference.",
      "sourceUrl": "https://github.com/QuantumNous/new-api/blob/6cf0d90b5ff27f901697dddd61e0c28aba8efefc/plugins/embed.go"
    },
    {
      "id": "backup-before-migration",
      "summary": "Snapshot the application configuration, data directory, PostgreSQL database and Redis persistence before replacement. Retain the previous image digest and verify a restore against a separate database before relying on rollback.",
      "sourceUrl": "https://github.com/QuantumNous/new-api/blob/6cf0d90b5ff27f901697dddd61e0c28aba8efefc/docker-compose.yml"
    }
  ]
