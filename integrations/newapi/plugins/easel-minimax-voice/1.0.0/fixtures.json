    {
      "name": "actual usage replaces reservation",
      "hook": "extractUsageOnComplete",
      "args": [
        {},
        {
          "status": "SUCCESS"
        },
        {
          "operation": "synthesize",
          "usage_characters": 5,
          "audio_length": 1200
        }
      ],
      "expected": {
        "characters": 5,
        "audio_milliseconds": 1200
      }
    },
