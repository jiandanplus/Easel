{
  "cases": [
    {
      "name": "multipart sample decoder",
      "hook": "native",
      "args": [
        {
          "query": {},
          "body": {
            "kind": "multipart",
            "fields": {
              "purpose": [
                "voice_clone"
              ]
            },
            "files": [
              {
                "ref": "request_file:file",
                "field": "file",
                "filename": "sample.wav",
                "mimeType": "audio/wav",
                "size": 1024
              }
            ]
          }
        }
      ],
      "member": "upload",
      "expected": {
        "kind": "submit",
        "action": "upload",
        "model": "easel-minimax-upload",
        "requestBody": {
          "purpose": "voice_clone"
        }
      }
    },
    {
      "name": "reject client URL",
      "hook": "native",
      "args": [
        {
          "query": {},
          "body": {
            "kind": "multipart",
            "fields": {
              "url": [
                "https://example.com/a.wav"
              ]
            },
            "files": [
              {
                "ref": "request_file:file",
                "field": "file",
                "filename": "sample.wav",
                "mimeType": "audio/wav",
                "size": 1024
              }
            ]
          }
        }
      ],
      "member": "upload",
      "expectedError": "unsupported field"
    },
    {
      "name": "single upload descriptor",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "action": "upload",
          "requestBody": {
            "purpose": "voice_clone"
          },
          "publicTaskId": "task_cccccccccccccccccccccccccccccccc",
          "baseUrl": "https://api.minimax.cn",
          "apiKey": "fixture-key",
          "files": [
            {
              "ref": "request_file:file",
              "field": "file",
              "filename": "sample.wav",
              "mimeType": "audio/wav",
              "size": 1024
            }
          ],
          "model": "easel-minimax-upload",
          "upstreamModel": "easel-minimax-upload"
        }
      ],
      "expected": {
        "url": "https://api.minimax.cn/v1/files/upload",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer fixture-key"
        },
        "bodyType": "multipart",
        "parts": [
          {
            "name": "purpose",
            "value": "voice_clone"
          },
          {
            "name": "file",
            "fileRef": "request_file:file",
            "filename": "sample.wav"
          }
        ]
      }
    },
    {
      "name": "reject untrusted channel host",
