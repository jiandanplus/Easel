              "filename": "sample.wav",
              "mimeType": "audio/wav",
              "size": 1024
            }
          ],
          "model": "easel-minimax-upload",
          "upstreamModel": "easel-minimax-upload"
        }
      ],
      "expectedError": "official MiniMax base URL"
    },
    {
      "name": "upload immediate completion",
