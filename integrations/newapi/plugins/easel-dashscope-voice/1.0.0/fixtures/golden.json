              }
            }
          }
        }
      ],
      "member": "verify",
      "expected": {
        "kind": "submit",
        "model": "voice-enrollment",
        "action": "query_voice",
        "requestBody": {
          "model": "voice-enrollment",
          "input": {
            "action": "query_voice",
            "voice_task_id": "task_enroll"
          }
        },
        "originTaskIds": [
          "task_enroll"
        ]
      }
    },
