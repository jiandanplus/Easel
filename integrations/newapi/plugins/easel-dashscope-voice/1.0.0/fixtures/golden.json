{
  "cases": [
    {
      "name": "Decode create_voice",
      "hook": "native",
      "args": [
        {
          "body": {
            "kind": "json",
            "value": {
              "model": "voice-enrollment",
              "input": {
                "action": "create_voice",
                "target_model": "cosyvoice-v2",
                "prefix": "myvoice",
                "url": "https://sample.example.test/sample.wav"
              }
            }
          }
        }
      ],
      "member": "enroll",
      "expected": {
        "kind": "submit",
        "model": "voice-enrollment",
        "action": "create_voice",
        "requestBody": {
          "model": "voice-enrollment",
          "input": {
            "action": "create_voice",
            "target_model": "cosyvoice-v2",
            "prefix": "myvoice",
            "url": "https://sample.example.test/sample.wav"
          }
        }
      }
    },
    {
