+       AND NOT EXISTS(SELECT 1 FROM membership_revocations r WHERE r.membership_id=m.id)) THEN
+ RAISE EXCEPTION 'internal feature grant binding divergence' USING ERRCODE='23514'; END IF;
+ RETURN NULL;
+END $$;
