+def provider(**patch):
+    values = dict(version='1', base_url='http://127.0.0.1:9999/v1', secret='synthetic-only',
+                  models={'fixture-image':'upstream'}, capabilities=('image.generate',),
+                  response_profile='newapi_images_v1')
+    return MediaProvider(**(values | patch))
